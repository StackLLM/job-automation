generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un journal par post généré. userId vient de la session (lot L0.5) ; les journaux d'avant les comptes
// restent sans propriétaire (null) et ne s'affichent pour personne.
model GeneratedPostLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String?
  description      String
  technologies     String?
  tone             String?
  model            String?
  generatedContent String
  rawResponse      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// ─── Données du compte (lot L0.7) ───────────────────────────────────────────
// Posts gardés par l'utilisateur et ses préférences. Les noms de colonnes suivent ceux du front.

model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String?
  model     String?
  content   String
  // Identifiant du post dans le navigateur, pour qu'un import relancé ne crée aucun doublon.
  idLocal   String?
  createdAt DateTime @default(now())

  @@unique([userId, idLocal])
  @@index([userId, createdAt])
}

model Parametres {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultTone    String   @default("Professionnel")
  scraperWebhook String   @default("")
  updatedAt      DateTime @updatedAt
}

// ─── Profils trouvés (lot L1.1) ─────────────────────────────────────────────
// Une recherche lancée par l'utilisateur, et les profils qu'elle a enregistrés.

model RechercheProfils {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requete   String
  lieu      String?
  pages     Int?
  // serper, brave, n8n, ou webhook (n8n réglé à la main dans Paramètres)
  source    String
  trouves   Int
  rejetes   Int
  createdAt DateTime @default(now())
  profils   Profil[]

  @@index([userId, createdAt])
}

// Une URL de profil n'apparaît qu'une fois par compte. La fusion des informations
// d'un profil déjà connu viendra avec le lot L1.3 ; d'ici là, la première version reste.
model Profil {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rechercheId   String?
  recherche     RechercheProfils? @relation(fields: [rechercheId], references: [id], onDelete: SetNull)
  urlNormalisee String
  nom           String?
  poste         String?
  entreprise    String?
  lieu          String?
  extrait       String?
  image         String?
  source        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, urlNormalisee])
  @@index([userId, createdAt])
}

// ─── Comptes et sessions (lot L0.4) ─────────────────────────────────────────
// Tables attendues par Better Auth (adaptateur Prisma). Les mots de passe sont hachés
// par Better Auth et rangés dans Account.password ; les sessions vivent en base.

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  postLogs      GeneratedPostLog[]
  posts         Post[]
  parametres    Parametres?
  profils       Profil[]
  recherches    RechercheProfils[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Jetons à usage unique : réinitialisation du mot de passe, vérification d'e-mail.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
